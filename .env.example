# Copy to .env and edit for your own initialized disposable source database.
# See https://github.com/dougwhite/gorak/blob/master/docs/getting-started.md
# Vnode and database are separate values, not vnode::database.
GORAK_BACKEND=local
GORAK_SQL_BACKEND=local
GORAK_VNODE=myvnode
GORAK_DATABASE=disposabledb

# For SSH execution, replace the two backend values above with remote and set:
# GORAK_REMOTE_HOST=windows-host.example
# GORAK_REMOTE_USER=developer
# GORAK_REMOTE_ROOT=C:\Development\gorak
# Then run: gorak remote install
#           gorak remote check

# UnitTestFramework may require execution-host paths/libraries; see its setup
# instructions and Gorak docs/run-test.md for GORAK_RUN_ENV_ settings.
