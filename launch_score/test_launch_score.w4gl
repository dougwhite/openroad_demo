[classsource]
superclass = "testcase"

[methods]
test_score = "METHOD"

===

METHOD test_score() =
DECLARE
    actual = integer;
ENDDECLARE
{
    actual = CALLPROC p4_score(capsules = 0);
    G_Assert.AssertEquals(expectedInteger = 0, actualInteger = actual);
    actual = CALLPROC p4_score(capsules = 1);
    G_Assert.AssertEquals(expectedInteger = 10, actualInteger = actual);
    actual = CALLPROC p4_score(capsules = 4);
    G_Assert.AssertEquals(expectedInteger = 40, actualInteger = actual);
    actual = CALLPROC p4_score(capsules = 5);
    G_Assert.AssertEquals(expectedInteger = 70, actualInteger = actual);
    actual = CALLPROC p4_score(capsules = 6);
    G_Assert.AssertEquals(expectedInteger = 80, actualInteger = actual);
}
